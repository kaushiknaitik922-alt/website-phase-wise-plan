# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon PostgreSQL — pooled connection string.
# Vercel's Neon integration sets DATABASE_URL instead; either name works.
DATABASE_URI=

# Random string, 32+ characters (openssl rand -base64 32)
PAYLOAD_SECRET=

# Public site URL, no trailing slash (https://shrilakhdatar.in)
NEXT_PUBLIC_SERVER_URL=

# Vercel Blob — media storage
BLOB_READ_WRITE_TOKEN=

# Resend — enquiry notification email
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# WhatsApp numbers shown on the site (public by design)
NEXT_PUBLIC_WHATSAPP_PRIMARY=8587060393
NEXT_PUBLIC_WHATSAPP_SECONDARY=8383044264
