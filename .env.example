# Optional — enables the owner-notification email from the Contact page's
# enquiry form (src/lib/resend.ts). Without these, enquiries are still saved
# (see src/lib/data/enquiries.ts) and the site works fully; only the email
# step is skipped, with a console log noting why.
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=

# --- Future CMS migration (not used by the current local data layer) ---
# When migrating src/lib/data/* to real Payload CMS collections/globals
# backed by Neon Postgres + Vercel Blob (see WEBSITE_ARCHITECTURE.md §3-5),
# these are the variables that build will need:
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
# PAYLOAD_SECRET=
